{
  "manifest_version": 3,
  "name": "Loud Crayon — OS Screenshot & Feedback",
  "version": "1.1.0",
  "description": "Capture page screenshots, inspect elements, and dispatch bug reports directly to Loud Crayon OS Feedback Inbox for Loud Crayon websites only.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://loudcrayon.com/*",
    "https://*.loudcrayon.com/*",
    "https://loudcrayon.co/*",
    "https://*.loudcrayon.co/*",
    "https://loud-crayon.vercel.app/*",
    "https://*.vercel.app/*",
    "http://localhost/*",
    "http://localhost:*/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Loud Crayon Feedback",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://loudcrayon.com/*",
        "https://*.loudcrayon.com/*",
        "https://loudcrayon.co/*",
        "https://*.loudcrayon.co/*",
        "https://loud-crayon.vercel.app/*",
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"]
    }
  ]
}
